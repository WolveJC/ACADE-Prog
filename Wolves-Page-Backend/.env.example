# Copia este archivo a ".env" y rellena los valores reales.
# El archivo ".env" (sin ".example") NUNCA se sube al repositorio.

# Dominio real del frontend en producción, para la cabecera CORS.
# En local, usa el puerto de tu "npm start" (por defecto 3000).
FRONTEND_ORIGIN=http://localhost:3000

# API key de Spoonacular (la misma que estaba hardcodeada en TriviaWidget.jsx).
# IMPORTANTE: si no la has regenerado todavía en el panel de Spoonacular,
# hazlo antes de poner esta en producción -- la vieja ya se consideró expuesta.
SPOONACULAR_API_KEY=tu_api_key_aqui

# API key de RapidAPI para "Edamam Nutrition Analysis"
# (la misma que estaba hardcodeada en CafePage.jsx). Mismo aviso que arriba.
RAPIDAPI_KEY=tu_api_key_aqui
